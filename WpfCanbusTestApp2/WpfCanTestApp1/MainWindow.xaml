<Window x:Class="WpfCanTestApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAN Bus Telemetry Tool" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 上方：控制面板（初始化 & 发送） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnInit" Content="初始化 CAN" Click="BtnInit_Click" Padding="10,5" Margin="0,0,10,0"/>

            <TextBlock Text="ID(Hex):" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="tbID" Text="123" Width="60" VerticalAlignment="Center"/>

            <TextBlock Text="Data(Hex):" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="tbSend" Text="01 02 03 04" Width="150" VerticalAlignment="Center"/>

            <Button x:Name="BtSend" Content="发送报文" Click="BtSend_Click" Padding="10,5" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 下方：实时显示日志列表 (关键绑定点) -->
        <ListBox Grid.Row="1" 
                 x:Name="LbLogs"
                 ItemsSource="{Binding DisplayLogs}" 
                 FontFamily="Consolas" 
                 FontSize="12"/>
    </Grid>
</Window>
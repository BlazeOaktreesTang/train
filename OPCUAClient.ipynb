   "source": [
    "from opcua import Client\n",
    "\n",
    "client = Client(\"opc.tcp://localhost:4840\")\n",
    "client.connect()\n",
    "\n",
    "# 读取温度\n",
    "temp = client.get_node(\"ns=2;s=AI1\").get_value()\n",
    "print(f\"当前温度：{temp} ℃\")\n",
    "\n",
    "client.disconnect()"
   ]

<Window x:Class="WpfSocketClient1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSocketClient1"
        mc:Ignorable="d"
        Title="SocketClient" Height="450" Width="405">
    <Grid>
        <Button Content="Connect" HorizontalAlignment="Left" Margin="74,87,0,0" VerticalAlignment="Top" Width="90" Height="36" Click="ButtonConnect_Click"/>
        <Label Name="lIP" Content="IP" HorizontalAlignment="Left" Margin="22,10,0,0" VerticalAlignment="Top" Width="25" Visibility="Collapsed"/>
        <TextBlock Name="tReceived" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,200,0,0" VerticalAlignment="Top" Width="380" Height="224" />
        <Button Content="close" HorizontalAlignment="Left" Margin="200,87,0,0" VerticalAlignment="Top" Width="90" Height="36" Click="ButtonClose_Click"/>
        <Label x:Name="lPort" Content="Port" HorizontalAlignment="Left" Margin="22,36,0,0" VerticalAlignment="Top" Width="47" Visibility="Collapsed"/>
        <TextBox Name="tbIP"  HorizontalAlignment="Left" Margin="74,10,0,0" VerticalAlignment="Top" Width="233" Height="26" Text="192.168.0.119" VerticalContentAlignment="Center" Visibility="Collapsed"/>
        <TextBox Name="tbPort"  HorizontalAlignment="Left" Margin="74,41,0,0" VerticalAlignment="Top" Width="233" Height="26" Text="8888" VerticalContentAlignment="Center" Visibility="Collapsed"/>
        <Button Content="cm1" HorizontalAlignment="Left" Margin="7,144,0,0" VerticalAlignment="Top" Width="38" Height="36" Click="Button_Click"/>
        <Button Content="cm2" HorizontalAlignment="Left" Margin="74,144,0,0" VerticalAlignment="Top" Width="38" Height="36" Click="Button_Click"/>
        <Button Content="cm3" HorizontalAlignment="Left" Margin="126,144,0,0" VerticalAlignment="Top" Width="38" Height="36" Click="Button_Click"/>
        <Button Content="cm4" HorizontalAlignment="Left" Margin="200,144,0,0" VerticalAlignment="Top" Width="45" Height="36" Click="Button_Click"/>
        <Button Content="cm5" HorizontalAlignment="Left" Margin="261,144,0,0" VerticalAlignment="Top" Width="38" Height="36" Click="Button_Click"/>
        <Button Content="cm6" HorizontalAlignment="Left" Margin="326,144,0,0" VerticalAlignment="Top" Width="38" Height="36" Click="Button_Click"/>
    </Grid>
</Window>
